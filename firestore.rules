rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // Helper functions
    function isSignedIn() {
      return request.auth != null;
    }

    function getUserRole() {
      return get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role;
    }

    function getUserDept() {
      return get(/databases/$(database)/documents/users/$(request.auth.uid)).data.department;
    }

    function isAdmin() {
      return isSignedIn() && getUserRole() == 'admin';
    }

    function isLeadOf(dept) {
      return isSignedIn() && getUserRole() == 'lead' && getUserDept() == dept;
    }

    // Users collection
    // - Anyone signed in can read user docs (needed to check own role)
    // - Users can create their own doc on first sign-in (defaults to member)
    // - Only admins can change roles
    match /users/{userId} {
      allow read: if isSignedIn();
      allow create: if isSignedIn()
                    && request.auth.uid == userId
                    && request.resource.data.role == 'member';
      allow update, delete: if isAdmin();
    }

    // Items collection
    // - Anyone (even signed out) can read inventory
    // - Admins can do everything
    // - Leads can only modify items in their own department
    match /items/{itemId} {
      allow read: if true;
      allow create: if isAdmin()
                    || isLeadOf(request.resource.data.department);
      allow update: if isAdmin()
                    || isLeadOf(resource.data.department);
      allow delete: if isAdmin()
                    || isLeadOf(resource.data.department);

      // History logs (subcollection)
      // - Anyone signed in can read history
      // - Anyone with edit rights on the parent item can add logs
      // - Logs cannot be edited or deleted (audit trail)
      match /logs/{logId} {
        allow read: if isSignedIn();
        allow create: if isAdmin()
                      || isLeadOf(get(/databases/$(database)/documents/items/$(itemId)).data.department);
        allow update, delete: if false;
      }
    }
  }
}